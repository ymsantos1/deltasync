.dart_tool/
build/
coverage/
.flutter-plugins-dependencies
*.apk
*.aab

# Avoid committing pubspec.lock for library packages; see
# https://dart.dev/tools/pub/private-files#pubspec-lock.
pubspec.lock

referencia/

*.patch
*-runtime.json

# Preserve reproducible evidence in version control.
!plan/evidence/*.patch
!plan/evidence/*-runtime.json

*.log

# Python bytecode and local experiment archives are generated, not source.
__pycache__/
*.py[cod]
.performance-artifacts/

# Personal task prompt; keep the local copy outside version control.
/prompt.txt
